# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx
# Server-only Supabase secret key. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx

# Razorpay Dashboard > Account & Settings > API Keys (test keys first)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
# Set this separately when creating the webhook in Razorpay Dashboard.
RAZORPAY_WEBHOOK_SECRET=use-a-long-random-webhook-secret

# Used to HMAC customer access codes. Generate a long random value.
CLAIM_CODE_SECRET=replace-with-at-least-32-random-bytes

# Optional; used for absolute links if you later add email notifications.
NEXT_PUBLIC_APP_URL=http://localhost:3000
